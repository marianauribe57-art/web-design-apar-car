generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMINISTRADOR
  OPERARIO
  CLIENTE
}

enum EstadoAfiliacion {
  PENDIENTE_VINCULACION
  ACTIVA
  INACTIVA
}

model Usuario {
  id                    String           @id @default(uuid()) @db.Uuid
  correo                String           @unique
  hashContrasena        String
  nombre                String
  telefono              String
  debeCambiarContrasena Boolean          @default(false)
  intentosFallidos      Int              @default(0)
  bloqueadoHasta        DateTime?        @db.Timestamptz
  activo                Boolean          @default(true)
  consentimientos       Consentimiento[]
  afiliaciones          Afiliacion[]
  movimientos           Movimiento[]
  bitacoras             Bitacora[]
}

model Consentimiento {
  id              String   @id @default(uuid()) @db.Uuid
  usuarioId       String   @db.Uuid
  versionPolitica String
  aceptadoEn      DateTime @default(now()) @db.Timestamptz
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
}

model Afiliacion {
  id                 String              @id @default(uuid()) @db.Uuid
  parqueaderoId      String              @db.Uuid
  usuarioId          String?             @db.Uuid
  rol                Rol
  estado             EstadoAfiliacion
  nombreTitular      String
  telefonoTitular    String
  creadoEn           DateTime            @default(now()) @db.Timestamptz
  parqueadero        Parqueadero         @relation(fields: [parqueaderoId], references: [id])
  usuario            Usuario?            @relation(fields: [usuarioId], references: [id])
  vinculosVehiculo   VinculoVehiculo[]
  codigosVinculacion CodigoVinculacion[]
  pagos              Pago[]
}

// ─── Entidades del parqueadero ───

enum TipoCelda {
  CARRO
  MOTO
  MIXTA
}

enum EstadoCelda {
  LIBRE
  OCUPADA
}

enum TipoVehiculo {
  CARRO
  MOTO
}

enum EstadoCodigoQr {
  ACTIVO
  REVOCADO
}

enum OrigenMovimiento {
  MANUAL
  LECTOR_QR
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  OTRO
}

model Parqueadero {
  id                 String              @id @default(uuid()) @db.Uuid
  nombre             String
  direccion          String
  creadoEn           DateTime            @default(now()) @db.Timestamptz
  celdas             Celda[]
  tarifas            Tarifa[]
  movimientos        Movimiento[]
  afiliaciones       Afiliacion[]
  vehiculos          Vehiculo[]
  dispositivos       Dispositivo[]
  bitacoras          Bitacora[]
  vinculosVehiculo   VinculoVehiculo[]
  codigosVinculacion CodigoVinculacion[]
  codigosQr          CodigoQr[]
  pagos              Pago[]
}

model Celda {
  id            String       @id @default(uuid()) @db.Uuid
  parqueaderoId String       @db.Uuid
  codigo        String
  tipoPermitido TipoCelda
  estado        EstadoCelda  @default(LIBRE)
  parqueadero   Parqueadero  @relation(fields: [parqueaderoId], references: [id])
  movimientos   Movimiento[]

  @@unique([parqueaderoId, codigo])
}

model Tarifa {
  id               String       @id @default(uuid()) @db.Uuid
  parqueaderoId    String       @db.Uuid
  valorHora        Decimal      @db.Decimal(10, 2)
  valorDia         Decimal      @db.Decimal(10, 2)
  valorMensualidad Decimal      @db.Decimal(10, 2)
  vigenteDesde     DateTime     @db.Timestamptz
  vigenteHasta     DateTime?    @db.Timestamptz
  parqueadero      Parqueadero  @relation(fields: [parqueaderoId], references: [id])
  movimientos      Movimiento[]
  pagos            Pago[]
}

model Vehiculo {
  id            String            @id @default(uuid()) @db.Uuid
  parqueaderoId String            @db.Uuid
  placa         String
  tipo          TipoVehiculo
  parqueadero   Parqueadero       @relation(fields: [parqueaderoId], references: [id])
  vinculos      VinculoVehiculo[]
  codigosQr     CodigoQr[]
  movimientos   Movimiento[]

  @@unique([parqueaderoId, placa])
}

model VinculoVehiculo {
  id            String      @id @default(uuid()) @db.Uuid
  parqueaderoId String      @db.Uuid
  afiliacionId  String      @db.Uuid
  vehiculoId    String      @db.Uuid
  fechaInicio   DateTime    @db.Timestamptz
  fechaFin      DateTime?   @db.Timestamptz
  parqueadero   Parqueadero @relation(fields: [parqueaderoId], references: [id])
  afiliacion    Afiliacion  @relation(fields: [afiliacionId], references: [id])
  vehiculo      Vehiculo    @relation(fields: [vehiculoId], references: [id])
}

model CodigoVinculacion {
  id               String      @id @default(uuid()) @db.Uuid
  parqueaderoId    String      @db.Uuid
  afiliacionId     String      @db.Uuid
  hashCodigo       String
  intentosFallidos Int         @default(0)
  venceEn          DateTime    @db.Timestamptz
  usadoEn          DateTime?   @db.Timestamptz
  parqueadero      Parqueadero @relation(fields: [parqueaderoId], references: [id])
  afiliacion       Afiliacion  @relation(fields: [afiliacionId], references: [id])
}

model CodigoQr {
  id            String         @id @default(uuid()) @db.Uuid
  parqueaderoId String         @db.Uuid
  vehiculoId    String         @db.Uuid
  token         String         @unique
  estado        EstadoCodigoQr @default(ACTIVO)
  emitidoEn     DateTime       @default(now()) @db.Timestamptz
  revocadoEn    DateTime?      @db.Timestamptz
  parqueadero   Parqueadero    @relation(fields: [parqueaderoId], references: [id])
  vehiculo      Vehiculo       @relation(fields: [vehiculoId], references: [id])
}

model Movimiento {
  id              String           @id @default(uuid()) @db.Uuid
  parqueaderoId   String           @db.Uuid
  celdaId         String           @db.Uuid
  tarifaId        String           @db.Uuid
  vehiculoId      String?          @db.Uuid
  registradoPorId String           @db.Uuid
  dispositivoId   String?          @db.Uuid
  placa           String
  tipoVehiculo    TipoVehiculo
  codigoTiquete   String?          @unique
  origen          OrigenMovimiento
  entradaEn       DateTime         @default(now()) @db.Timestamptz
  salidaEn        DateTime?        @db.Timestamptz
  valorCobrado    Decimal          @db.Decimal(10, 2)
  anulado         Boolean          @default(false)
  motivoAnulacion String?
  parqueadero     Parqueadero      @relation(fields: [parqueaderoId], references: [id])
  celda           Celda            @relation(fields: [celdaId], references: [id])
  tarifa          Tarifa           @relation(fields: [tarifaId], references: [id])
  vehiculo        Vehiculo?        @relation(fields: [vehiculoId], references: [id])
  registradoPor   Usuario          @relation(fields: [registradoPorId], references: [id])
  dispositivo     Dispositivo?     @relation(fields: [dispositivoId], references: [id])
}

model Pago {
  id              String      @id @default(uuid()) @db.Uuid
  parqueaderoId   String      @db.Uuid
  afiliacionId    String      @db.Uuid
  tarifaId        String      @db.Uuid
  monto           Decimal     @db.Decimal(10, 2)
  medioPago       MedioPago
  fechaPago       DateTime    @db.Timestamptz
  periodoDesde    DateTime    @db.Timestamptz
  periodoHasta    DateTime    @db.Timestamptz
  anulado         Boolean     @default(false)
  motivoAnulacion String?
  parqueadero     Parqueadero @relation(fields: [parqueaderoId], references: [id])
  afiliacion      Afiliacion  @relation(fields: [afiliacionId], references: [id])
  tarifa          Tarifa      @relation(fields: [tarifaId], references: [id])
}

model Dispositivo {
  id            String       @id @default(uuid()) @db.Uuid
  parqueaderoId String       @db.Uuid
  nombre        String
  hashClave     String
  activo        Boolean      @default(true)
  parqueadero   Parqueadero  @relation(fields: [parqueaderoId], references: [id])
  movimientos   Movimiento[]
}

// creadoEn es de solo anexión (RNF-07): la bitácora nunca se actualiza, solo se inserta
model Bitacora {
  id            String      @id @default(uuid()) @db.Uuid
  parqueaderoId String      @db.Uuid
  usuarioId     String?     @db.Uuid
  accion        String
  entidad       String
  detalle       Json
  creadoEn      DateTime    @default(now()) @db.Timestamptz
  parqueadero   Parqueadero @relation(fields: [parqueaderoId], references: [id])
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])
}
