generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMINISTRADOR
  OPERARIO
  CLIENTE
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombre         String
  correo         String   @unique
  contrasenaHash String
  rol            Rol
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now())
}